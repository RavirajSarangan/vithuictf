{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/batch-notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/birthday-wishes",
      "schedule": "30 3 * * *"
    }
  ]
}
